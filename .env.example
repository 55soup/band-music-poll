# Supabase 설정 (Project Settings > API)
# 실제 값은 .env.local 에 넣으세요. 이 파일은 템플릿입니다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# YouTube Data API v3 (서버 전용) — 앱 내 유튜브 검색용
# Google Cloud Console > API 및 서비스 에서 "YouTube Data API v3" 사용 설정 후 API 키 생성
YOUTUBE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx
# 하루 검색 한도 (선택, 기본 100 = 무료 할당량). 넘으면 검색 차단.
# YOUTUBE_SEARCH_DAILY_LIMIT=100
